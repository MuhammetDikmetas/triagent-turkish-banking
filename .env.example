# --- LLM provider -----------------------------------------------------------
# One of: gemini | groq | ollama | openai | none
#   none  -> fully offline mode (fast classifier + rules + template replies)
LLM_PROVIDER=gemini
LLM_API_KEY=your-api-key-here
# Leave empty to use the provider default (see src/triagent/config.py)
LLM_MODEL=

# --- Routing ----------------------------------------------------------------
# Messages whose fast-classifier confidence is below this go to the LLM.
# Leave commented to use the value picked by cross-validation in scripts/train.py.
# CONFIDENCE_THRESHOLD=0.59

# Fast classifier text encoder: tfidf (no download) | e5 (needs `pip install .[embeddings]`)
ENCODER=tfidf